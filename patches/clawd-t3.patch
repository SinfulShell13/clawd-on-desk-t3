+exports.fixture={createLocal:async()=>local,now:()=>Date.now()+timeOffset,async verify(hud,{runtime,dashboard}){
+  assert.equal(slowDetailPending,true,"the HUD must appear before the optional history detail returns");
+  const rows=await hud.executeJavaScript("({rows:document.querySelectorAll('.row:not(.row-folded)').length,states:document.querySelectorAll('.state-chip').length,usage:document.querySelectorAll('.usage-chip').length,text:document.body.innerText})");
+  assert.equal(rows.rows,4);assert.equal(rows.states,4);assert.equal(rows.usage,0);assert.ok(!rows.text.includes("已完成"));
+  assert.ok(!rows.text.includes("Codex 子代理"));
