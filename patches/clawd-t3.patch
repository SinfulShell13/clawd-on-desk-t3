+"use strict";
+const assert = require("node:assert/strict");
+const { EventEmitter, once } = require("node:events");
+const { shell, webContents } = require("electron");
+const events = new EventEmitter();
+const commands = [];
+const opened = [];
+const openedFolders = [];
+let releaseSlowDetail;
+let slowDetailPending = true;
+let timeOffset = 0;
+const slowDetail = new Promise(resolve => { releaseSlowDetail = () => { slowDetailPending = false; resolve(); }; });
+const fixtureFolder = require("node:path").resolve(__dirname,"../..");
+shell.openExternal = async url => { opened.push(url); events.emit("opened"); };
+shell.openPath = async path => { openedFolders.push(path); return ""; };
+function client(id, threads) {
+  const projections = new Map(threads.map(thread => [thread.id, {
+    thread, runs:[{id:`run-${thread.id}`,status:"running"}], nodes:[{id:`node-${thread.id}`,runId:`run-${thread.id}`}],
+    providerThreads:[{id:thread.activeProviderThreadId,providerInstanceId:thread.providerInstanceId,driver:thread.providerInstanceId}],
+    runtimeRequests:thread.pendingRuntimeRequest ? [{id:`req-${thread.id}`,nodeId:`node-${thread.id}`,status:"pending",kind:thread.id === "question" ? "user_input":"command",createdAt:"2026-11-21T01:00:00Z",responseCapability:{type:"live"}}]:[],
+    turnItems:thread.id === "question" ? [{type:"user_input_request",requestId:"req-question",questions:[
+      {id:"target",header:"Target",question:"请选择测试目标",options:[{label:"仅测试夹具",description:"不会操作真实任务",value:"fixture-only"}],allowCustomAnswer:false},
+      {id:"note",header:"Note",question:"补充说明",options:[],allowCustomAnswer:true,initialAnswer:"初始草稿"},
+    ]}] : [{type:"approval_request",requestId:`req-${thread.id}`,prompt:"approval fixture · echo fixture-only",options:[{decision:"accept",label:"Allow once"},{decision:"decline",label:"Deny"}]}],
+  }]));
+  let failQuestionOnce = true;
+  let environmentIcon = "linux";
+  return { environmentId:id, expiresAt:new Date(Date.now()+3600000).toISOString(),
+    environmentIcon: async () => environmentIcon,
+    setEnvironmentIcon(icon) { environmentIcon = icon; },
