+    const row=icons.find(row=>row.title.includes(title));
+    assert.ok(row?.src.endsWith(`/agents/${icon}.png`),`${title} must show ${icon}`);
+    assert.ok(row.tooltip.startsWith("T3 Code · "));
+  }
