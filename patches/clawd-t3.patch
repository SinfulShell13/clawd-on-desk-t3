+  let approval,question;
+  for(const wc of bubbles){wc.setBackgroundThrottling(false);await wait(wc,"document.getElementById('toolPillText').textContent || document.querySelector('#elicitationForm input')");
+    const text=await wc.executeJavaScript("document.body.textContent");if(text.includes("approval fixture"))approval=wc;else question=wc;}
+  assert.ok(approval);assert.ok(question);assert.equal(commands.length,0);
+  next=once(events,"command");await approval.executeJavaScript("document.getElementById('btnAllow').click()");await next;
