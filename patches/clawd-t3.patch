+  await wait(hud,"[...document.querySelectorAll('.row')].find(r=>r.querySelector('.title')?.textContent.includes('Codex 远端'))?.querySelector('.agent-icon')?.src.endsWith('/agents/claude-code.png')");
+  remote.setProvider("codex","unknown-provider");await runtime.refresh();
