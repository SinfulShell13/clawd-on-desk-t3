diff --git a/scripts/manual/pet-window-smoke.js b/scripts/manual/pet-window-smoke.js
new file mode 100644
index 0000000000000000000000000000000000000000..bcb5bdb97a6afaf001dd7088dea47599139545ea
--- /dev/null
+++ b/scripts/manual/pet-window-smoke.js
@@ -0,0 +1,96 @@
+"use strict";
+
+// Full, isolated Clawd: real native pet/HUD windows, synthetic T3 sessions.
+// Fault injection exercises visibility recovery, not a physical monitor unplug.
+const assert = require("node:assert/strict");
+const path = require("node:path");
+const { BrowserWindow, screen } = require("electron");
+const delay = ms => new Promise(resolve => setTimeout(resolve, ms));
+const shortTitle = "校对话整理工作报";
+const longTitle = "A conversation title wider than the row";
+let petRuntime;
+const petRuntimeFile = require.resolve("../../src/pet-window-runtime");
+const createPetRuntime = require(petRuntimeFile);
+require.cache[petRuntimeFile].exports = options => (petRuntime = createPetRuntime(options));
+
+async function waitFor(predicate, message, timeout = 2000) {
+  const deadline = Date.now() + timeout;
+  while (!predicate()) {
+    assert.ok(Date.now() < deadline, message);
+    await delay(25);
+  }
+}
+
+exports.fixture = {
+  createLocal: async () => ({
+    environmentId: "window-fixture", expiresAt: new Date(Date.now() + 3600000).toISOString(),
+    shell: async () => ({ threads: [shortTitle, longTitle].map((title, index) => ({
+      id: `window-${index}`, title, providerInstanceId: "codex", status: "running",
+      activeRunId: `run-${index}`, latestRunId: `run-${index}`, updatedAt: new Date().toISOString(),
+      lineage: { parentThreadId: null },
+    })), projects: [] }),
+    call: async () => ({ links: [] }), projection: async () => ({ providerThreads: [] }), close: async () => {},
+    dispatch: async () => { throw new Error("Window smoke forbids task mutations"); },
+  }),
+  async verify(hud) {
+    const titles = await hud.executeJavaScript(`(() => {
+      const context = document.createElement('canvas').getContext('2d');
+      return [...document.querySelectorAll('.row .title')].map(el => {
+        const style = getComputedStyle(el); context.font = style.font;
+        return {text:el.textContent,tooltip:el.title,width:el.clientWidth,scrollWidth:el.scrollWidth,
+          fullTextWidth:context.measureText(el.textContent).width,ellipsis:style.textOverflow};
+      });
+    })()`);
+    const short = titles.find(row => row.text === shortTitle);
+    const long = titles.find(row => row.text === longTitle);
+    assert.ok(short, "CJK title must remain complete beyond seven characters");
+    assert.ok(long, "long title must remain complete in the DOM");
+    assert.equal(short.tooltip, shortTitle);
+    assert.equal(long.tooltip, longTitle);
+    assert.equal(long.ellipsis, "ellipsis");
+    assert.ok(long.scrollWidth > long.width, "CSS must clip a title only when it exceeds its allocated width");
+    if (process.platform !== "win32") return { fullTitles: true, cssClipping: true, nativeVisibility: "Windows-only" };
+
+    const windows = BrowserWindow.getAllWindows();
+    const render = windows.find(win => win.webContents.getURL().endsWith("/index.html"));
+    const hit = windows.find(win => win.webContents.getURL().endsWith("/hit.html"));
+    const hudWindow = BrowserWindow.fromWebContents(hud);
+    assert.ok(render && hit && petRuntime);
+    const before = render.getBounds();
+    const display = screen.getPrimaryDisplay();
+    for (const event of ["display-metrics-changed", "display-removed", "display-added"]) {
+      for (const target of [render, hit]) {
+        target.hide();
+        assert.equal(petRuntime.isPetEffectivelyHidden(), false);
+        screen.emit(event, {}, display, ["bounds", "scaleFactor"]);
+        await waitFor(() => render.isVisible() && hit.isVisible(), `${event} must recover native visibility`);
+        assert.equal(hudWindow.isVisible(), true);
+        assert.deepEqual(render.getBounds(), before, "recovery must preserve the logical pet position");
+      }
+    }
+
+    // Wait past the debounced topology work, then lose visibility without a
+    // new display event: the existing 5s watchdog must repair this late loss.
+    await delay(600);
+    render.hide();
+    await waitFor(() => render.isVisible(), "watchdog must recover a late native hide", 6000);
+    assert.deepEqual(render.getBounds(), before);
+
+    petRuntime.setPetHidden(true);
+    screen.emit("display-metrics-changed", {}, display, ["bounds"]);
+    await delay(600);
+    assert.equal(render.isVisible(), false, "topology must respect manual hiding");
+    assert.equal(petRuntime.recoverUnexpectedNativeVisibility(), "hidden");
+    petRuntime.setPetHidden(false);
+    await waitFor(() => render.isVisible() && hudWindow.isVisible(), "manual show must restore pet and HUD");
+
+    const bitmap = (await render.webContents.capturePage()).toBitmap();
+    assert.ok(bitmap.some((value, index) => index % 4 === 3 && value > 0), "restored pet must contain painted pixels");
+    return { fullTitles: true, cssClipping: true, nativeTopologyCases: 6, lateVisibilityRecovered: true,
+      manualHideRespected: true, positionPreserved: true, paintedPet: true };
+  },
+};
+
+process.env.T3_SMOKE_FIXTURE = "window";
+process.env.T3_SMOKE_OUTPUT ||= path.resolve(__dirname, "../../../validation/window-title");
+require("./t3-app-smoke");
diff --git a/scripts/manual/t3-app-smoke.js b/scripts/manual/t3-app-smoke.js
new file mode 100644
index 0000000000000000000000000000000000000000..70f4dc2928f66f08dd653f3ece61a425f1310063
--- /dev/null
+++ b/scripts/manual/t3-app-smoke.js
@@ -0,0 +1,85 @@
+"use strict";
+
+// Runs the complete app with a temporary Clawd home; only the explicitly selected T3 home is real.
+const { app, BrowserWindow, webContents } = require("electron");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const assert = require("node:assert/strict");
+const { once } = require("node:events");
+
+const originalHome = os.homedir();
+const isolatedHome = fs.mkdtempSync(path.join(os.tmpdir(), "clawd-t3-app-"));
+const output = path.resolve(process.env.T3_SMOKE_OUTPUT || path.join(__dirname, "../../../validation"));
+fs.mkdirSync(output, { recursive: true });
+process.env.T3CODE_HOME ||= path.join(originalHome, ".t3");
+process.env.T3CODE_CLI_PATH ||= path.join(originalHome, ".t3", "bin", process.platform === "win32" ? "t3.cmd" : "t3");
+process.env.USERPROFILE = isolatedHome;
+process.env.HOME = isolatedHome;
+assert.equal(os.homedir(), isolatedHome, "Clawd home must be isolated before any app modules load");
+const userData = path.join(isolatedHome, "userData");
+fs.mkdirSync(userData);
+app.setPath("userData", userData);
+const prefs = require("../../src/prefs").getDefaults();
+for (const entry of Object.values(prefs.agents)) { entry.enabled = false; entry.integrationInstalled = false; }
+Object.assign(prefs, {
+  lang: "zh", t3Enabled: true, recapEnabled: false, autoUpdateCheck: false,
+  manageClaudeHooksAutomatically: false, autoStartWithClaude: false, autoStartWithCodex: false,
+  sessionHudEnabled: true, sessionHudPinned: true, sessionHudShowContextUsage: false, sessionHudShowQuota: false,
+  tutorialSeen: true,
+});
+fs.writeFileSync(path.join(userData, "clawd-prefs.json"), JSON.stringify(prefs));
+fs.mkdirSync(output, { recursive: true });
+process.argv.push("--dashboard");
+const deadline = setTimeout(() => { console.error("T3 smoke timed out"); app.exit(1); }, 60000);
+const dashboardReady = new Promise(resolve => {
+  app.on("web-contents-created", (_event, wc) => {
+    wc.on("did-finish-load", () => { if (wc.getURL().endsWith("/dashboard.html")) resolve(wc); });
+  });
+});
+const hudReady = new Promise(resolve => {
+  app.on("web-contents-created", (_event, wc) => {
+    wc.on("did-finish-load", () => { if (wc.getURL().endsWith("/session-hud.html")) resolve(wc); });
+  });
+});
+const fixture = process.env.T3_SMOKE_FIXTURE === "1" ? require("./t3-hud-smoke").fixture
+  : process.env.T3_SMOKE_FIXTURE === "window" ? require("./pet-window-smoke").fixture : null;
+
+const runtimeModule = require("../../src/t3-runtime");
+const createRuntime = runtimeModule.createT3Runtime;
+let observedRuntime;
+runtimeModule.createT3Runtime = options => {
+  observedRuntime = createRuntime({ ...options, ...(fixture ? { createLocal: fixture.createLocal,
+    ...(fixture.now ? { now: fixture.now } : {}) } : {}), onChange(snapshot, refs) {
+    options.onChange(snapshot, refs);
+  } });
+  return observedRuntime;
+};
+require("../../src/main");
+let smokeFailure = false;
+app.whenReady().then(async () => {
+  const wc = await dashboardReady;
+  wc.setBackgroundThrottling(false);
+  await observedRuntime.refresh();
+  const runtimeSnapshot = observedRuntime.snapshot();
+  assert.ok(runtimeSnapshot.environments.some(env => env.local && env.connected));
+  await wc.executeJavaScript(`new Promise(resolve => {
+    const ready = () => { if (document.querySelectorAll('.card').length > 0) { observer.disconnect(); resolve(true); } };
+    const observer = new MutationObserver(ready); observer.observe(document.body, {childList:true,subtree:true}); ready();
+  })`);
+  if (!fixture) fs.writeFileSync(path.join(output, "t3-live-app.png"), (await wc.capturePage()).toPNG());
+  const form = await wc.executeJavaScript("({sessions:document.querySelectorAll('.card').length,overflow:document.body.scrollWidth > innerWidth})");
+  assert.equal(form.overflow, false);
+  const hud = await hudReady;
+  hud.setBackgroundThrottling(false);
+  await hud.executeJavaScript(`new Promise(resolve=>{const test=()=>{if(document.querySelectorAll('.row').length){o.disconnect();resolve(true);}};const o=new MutationObserver(test);o.observe(document.body,{subtree:true,childList:true});test();})`);
+  const hudResult = fixture ? await fixture.verify(hud, { runtime: observedRuntime, dashboard: wc }) : {visible:true};
+  fs.writeFileSync(path.join(output, fixture ? "t3-hud-fixture.png" : "t3-hud-live.png"),(await hud.capturePage()).toPNG());
+  console.log(JSON.stringify({ ok: true, isolatedHome, windows: BrowserWindow.getAllWindows().length,
+    environments: runtimeSnapshot.environments.map(env => ({ id: env.id, connected: env.connected, sessions: env.sessions.length })), form, hudResult }));
+}).catch(error => { console.error(error); smokeFailure = true; }).finally(async () => {
+  clearTimeout(deadline);
+  await observedRuntime?.stop();
+  if (smokeFailure) app.exit(1);
+  else app.quit();
+});
diff --git a/scripts/manual/t3-hud-smoke.js b/scripts/manual/t3-hud-smoke.js
