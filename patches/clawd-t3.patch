+
+const PROVIDERS = new Map([
+  ["codex", { agentId: "codex", name: "Codex" }],
+  ["claudeAgent", { agentId: "claude-code", name: "Claude Code" }],
+  ["claude", { agentId: "claude-code", name: "Claude Code" }],
+  ["opencode", { agentId: "opencode", name: "OpenCode" }],
+  ["antigravity", { agentId: "antigravity-cli", name: "Antigravity" }],
+  ["cursor", { agentId: "cursor-agent", name: "Cursor" }],
+  ["grok", { agentId: "grok-build", name: "Grok Build" }],
+  ["kiro", { agentId: "kiro-cli", name: "Kiro CLI" }],
+  ["pi", { agentId: "pi", name: "Pi" }],
+]);
+
+function getT3ProviderPresentation(instanceId, driver) {
+  // Built-in instance ids equal their driver kind; custom names are never guessed.
+  return PROVIDERS.get(driver || instanceId) || { agentId: "t3-code", name: instanceId || "T3" };
+}
+
+module.exports = { getT3ProviderPresentation };
