+++ b/test/t3-client.test.js
@@ -0,0 +1,80 @@
+"use strict";
+
+const { it } = require("node:test");
+const assert = require("node:assert/strict");
+const { EventEmitter } = require("node:events");
+const { createPublicKey, createHash, verify } = require("node:crypto");
+const { T3Client, T3Rpc, validOrigin } = require("../src/t3-client");
+const { createDpopSigner } = require("../src/t3-dpop");
+
+class Socket extends EventEmitter {
+  readyState = 1;
+  sent = [];
+  send(message) { this.sent.push(JSON.parse(message)); }
+  close() { this.readyState = 3; this.emit("close"); }
+  receive(message) { this.emit("message", Buffer.from(JSON.stringify(message))); }
+}
+
+it("reads the configured environment icon with T3's detected/default fallback and no settings write", async () => {
+  const client = new T3Client({ origin: "https://environment.example", token: "fixture-only" });
+  let config;
+  client.call = async (tag, payload) => {
+    assert.equal(tag, "server.getConfig");
+    assert.equal(payload, undefined);
+    return config;
+  };
+  for (const [configured, machine, expected] of [["cloud", "desktop", "cloud"], [null, "linux", "linux"],
+    ["future-kind", "laptop", "laptop"], [null, undefined, "server"]]) {
+    config = { settings: { environmentIcon: configured }, environment: { platform: { machine } } };
+    assert.equal(await client.environmentIcon(), expected);
+  }
+});
+
+it("correlates native Effect RPC exits and heartbeats without exposing upstream failures", async () => {
+  const socket = new Socket();
+  const rpc = new T3Rpc(socket);
+  const first = rpc.call("peerLinks.names", {});
+  const second = rpc.call("orchestration.dispatchCommand", { threadId: "thread" });
+  assert.deepEqual(socket.sent[0], { _tag: "Request", id: "1", tag: "peerLinks.names", payload: {}, headers: [] });
+  socket.receive({ _tag: "Ping" });
+  assert.deepEqual(socket.sent.at(-1), { _tag: "Pong" });
+  socket.receive({ _tag: "Exit", requestId: "2", exit: { _tag: "Failure", cause: [{ error: "private upstream content" }] } });
+  await assert.rejects(second, /^Error: T3_RPC_REFUSED$/);
+  socket.receive([{ _tag: "Exit", requestId: "1", exit: { _tag: "Success", value: { links: [] } } }]);
+  assert.deepEqual(await first, { links: [] });
+  rpc.close();
+});
+
+it("rejects in-flight mutations on disconnect and never sends them again", async () => {
+  const socket = new Socket();
+  const rpc = new T3Rpc(socket);
+  const pending = rpc.call("orchestration.dispatchCommand", { commandId: "one" });
+  socket.close();
+  await assert.rejects(pending, /T3_DISCONNECTED/);
+  assert.equal(socket.sent.length, 1);
+  await assert.rejects(rpc.call("anything", {}), /T3_DISCONNECTED/);
+  assert.equal(socket.sent.length, 1);
+});
+
+it("restricts runtime discovery to loopback and rejects URLs that could redirect credentials", () => {
+  assert.equal(validOrigin("http://127.0.0.1:9999", true), "http://127.0.0.1:9999");
+  for (const value of ["https://remote.example", "file:///tmp/x", "http://user:pass@localhost", "http://localhost/path", "http://localhost/?token=x"]) {
+    assert.throws(() => validOrigin(value, true));
+  }
+});
+
+it("signs short-lived DPoP proofs bound to each HTTP method, URL and access token with an ephemeral key", () => {
+  const signer = createDpopSigner();
+  const proof = signer("get", "https://example.test/api/orchestration/shell?omitIdleSubagents=1", "token");
+  const [header, payload, signature] = proof.split(".");
+  const h = JSON.parse(Buffer.from(header, "base64url"));
+  const p = JSON.parse(Buffer.from(payload, "base64url"));
+  assert.equal(h.alg, "ES256"); assert.equal(h.typ, "dpop+jwt"); assert.equal(h.jwk.d, undefined);
+  assert.equal(p.htm, "GET"); assert.equal(p.htu, "https://example.test/api/orchestration/shell");
+  assert.equal(p.ath, createHash("sha256").update("token").digest("base64url"));
+  assert.ok(verify("sha256", Buffer.from(`${header}.${payload}`), {
+    key: createPublicKey({ key: h.jwk, format: "jwk" }), dsaEncoding: "ieee-p1363",
+  }, Buffer.from(signature, "base64url")));
+  const next = JSON.parse(Buffer.from(signer("GET", "https://example.test/api", "token").split(".")[1], "base64url"));
+  assert.notEqual(next.jti, p.jti);
+});
