+    async shell(){return {threads,projects:[]};}, async projection(id){if(id === "done")await slowDetail;return structuredClone(projections.get(id));}, async close(){releaseSlowDetail();},
+    async dispatch(command){
+      if (command.threadId === "question" && command.answers && failQuestionOnce) { failQuestionOnce=false;events.emit("failed");throw new Error("T3_FIXTURE_DISCONNECT"); }
+      commands.push(command);if(command.type === "runtime-request.respond"){
+      const p=projections.get(command.threadId);p.runtimeRequests[0].status="resolved";p.thread.pendingRuntimeRequest=null;
+    }events.emit("command");return {sequence:commands.length};},
+  };
+}
+function thread(id,title,status="running",pending=false){return {id,title,status,providerInstanceId:({agy:"antigravity",question:"claudeAgent",opencode:"opencode"})[id]||"codex",activeProviderThreadId:`provider-${id}`,modelSelection:{model:"fixture"},projectId:"fixture",worktreePath:fixtureFolder,activeRunId:`run-${id}`,latestRunId:`run-${id}`,updatedAt:new Date().toISOString(),lineage:{parentThreadId:null},pendingRuntimeRequest:pending?{id:`req-${id}`}:null};}
+const local=client("local-fixture",[thread("agy","AGY 本机","running",true),thread("question","提问 本机","waiting",true),thread("done","已完成","completed"),
+  { ...thread("agy-child","Codex 子代理"), lineage:{parentThreadId:"agy",relationshipToParent:"subagent"} }]);
