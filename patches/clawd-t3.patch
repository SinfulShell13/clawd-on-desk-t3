diff --git a/scripts/manual/t3-live-smoke.js b/scripts/manual/t3-live-smoke.js
new file mode 100644
index 0000000000000000000000000000000000000000..d29f792990d3d8274cac557ed80d267dd659c599
--- /dev/null
+++ b/scripts/manual/t3-live-smoke.js
@@ -0,0 +1,48 @@
+"use strict";
+
+// Creates and deletes only empty, UUID-named test threads. It never sends a prompt or answers a real request.
+const { randomUUID } = require("node:crypto");
+const assert = require("node:assert/strict");
+const { T3Client } = require("../../src/t3-client");
+
+async function check(client) {
+  const shell = await client.shell();
+  const template = shell.threads.find(thread => !thread.archivedAt && !thread.deletedAt);
+  assert.ok(template, "This environment needs an existing project/thread for the empty fixture");
+  const threadId = randomUUID();
+  let created = false;
+  try {
+    await client.dispatch({
+      type: "thread.create", commandId: randomUUID(), threadId, projectId: template.projectId,
+      title: `[Clawd T3 empty smoke ${threadId}]`, modelSelection: template.modelSelection,
+      runtimeMode: "approval-required", interactionMode: "default", branch: null, worktreePath: null,
+      createdBy: "user", creationSource: "web",
+    });
+    created = true;
+    const projection = await client.projection(threadId);
+    assert.equal(projection.thread.id, threadId);
+    assert.equal(projection.runs.length, 0);
+    await client.dispatch({ type: "thread.metadata.update", commandId: randomUUID(), threadId, title: "Clawd T3 verified empty fixture" });
+    const updated = await client.projection(threadId);
+    assert.equal(updated.thread.title, "Clawd T3 verified empty fixture");
+    console.log(JSON.stringify({ environmentId: client.environmentId, shellThreads: shell.threads.length, rpcWriteVerified: true, agentRuns: 0 }));
+  } finally {
+    if (created) {
+      await client.dispatch({ type: "thread.delete", commandId: randomUUID(), threadId, onlyIfUnused: true });
+      const final = await client.shell();
+      assert.equal(final.threads.some(thread => thread.id === threadId), false);
+    }
+  }
+}
+
+(async () => {
+  const local = await T3Client.local();
+  try {
+    await check(local);
+    const { links } = await local.call("peerLinks.names");
+    for (const link of links) {
+      const remote = await local.linkedClient(link.environmentId);
+      try { await check(remote); } finally { await remote.close(); }
+    }
+  } finally { await local.close(); }
+})().catch(error => { console.error(error.code || error.message); process.exitCode = 1; });
