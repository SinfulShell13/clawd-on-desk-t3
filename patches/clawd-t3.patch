+  assert.equal(await question.executeJavaScript("document.querySelector('#elicitationForm textarea').value"),"初始草稿");
+  await question.executeJavaScript("document.querySelector('#elicitationForm .option-item-other input').click();const input=document.querySelector('#elicitationForm textarea');input.value='人工测试回答';input.dispatchEvent(new Event('input'))");
+  next=once(events,"failed");await question.executeJavaScript("document.getElementById('btnAllow').click()");await next;
+  await wait(question,"document.querySelector('.session-trust-error')");
+  assert.equal(await question.executeJavaScript("document.querySelector('#elicitationForm textarea').value"),"人工测试回答");
+  next=once(events,"command");await question.executeJavaScript("document.getElementById('btnAllow').click()");await next;
