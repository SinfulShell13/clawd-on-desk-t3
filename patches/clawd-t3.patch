diff --git a/build/build-t3-windows.js b/build/build-t3-windows.js
new file mode 100644
index 0000000000000000000000000000000000000000..d701a60ddca197d739c5f326341485128b03d23f
--- /dev/null
+++ b/build/build-t3-windows.js
@@ -0,0 +1,18 @@
+"use strict";
+
+const { spawnSync } = require("node:child_process");
+const path = require("node:path");
+
+const env = { ...process.env };
+delete env.ELECTRON_RUN_AS_NODE;
+const result = spawnSync(process.execPath, [
+  require.resolve("electron-builder/cli.js"), "--win", "nsis:x64", "--publish", "never",
+  "--config.directories.output=dist/t3-local",
+  "--config.win.artifactName=Clawd-on-Desk-T3-Local-Setup-${version}-${arch}.${ext}",
+  // Reuse the registered current-user installation; do not offer a second
+  // location/scope that leaves startup entries and hook paths split.
+  "--config.nsis.allowToChangeInstallationDirectory=false",
+  "--config.nsis.allowElevation=false",
+], { cwd: path.join(__dirname, ".."), env, stdio: "inherit", windowsHide: true });
+if (result.error) throw result.error;
+process.exitCode = result.status ?? 1;
diff --git a/build/installer.nsh b/build/installer.nsh
index 7033a900ad7b0cde7acf1f35652677400af1616f..53e9945b7f53928959689c0ea3a9203d0e6f6d6a 100644
--- a/build/installer.nsh
+++ b/build/installer.nsh
@@ -1,6 +1,8 @@
 ; customCheckAppRunning makes allowOnlyOneInstallerInstance.nsh skip these dependencies, so provide them here.
-!include "getProcessInfo.nsh"
-Var pid
+!ifdef BUILD_UNINSTALLER
+  !include "getProcessInfo.nsh"
+  Var pid
+!endif
 
 ; PowerShell 5.1 leaves .Count empty for one CimInstance, missing the last Clawd process (#882, electron-builder#10454).
 ; These macros match electron-builder 26.15.7 line for line except for @(...) and the CLAWD_FIND_PROCESS name.
@@ -206,9 +208,34 @@ Var pid
 
 !macro customCheckAppRunning
   !insertmacro IS_POWERSHELL_AVAILABLE
-  !insertmacro CLAWD_CHECK_APP_RUNNING
-  ; The installer also checks deletion access before uninstalling the old version. The uninstaller skips this precheck.
+  !ifdef BUILD_UNINSTALLER
+    !insertmacro CLAWD_CHECK_APP_RUNNING
+  !endif
   !ifndef BUILD_UNINSTALLER
+    ; A local fork must preserve the existing installation and data before the
+    ; upstream uninstaller runs. Also catches a portable build using that data.
+    ; Do not force-stop it: a normal tray exit flushes settings and approvals.
+    InitPluginsDir
+    IfFileExists "$PLUGINSDIR\clawd-t3-backup-complete" clawd_t3_backup_done
+    File "/oname=$PLUGINSDIR\t3-migration-backup.ps1" "${BUILD_RESOURCES_DIR}\t3-migration-backup.ps1"
+    clawd_t3_backup_retry:
+      nsExec::ExecToStack 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$PLUGINSDIR\t3-migration-backup.ps1" -InstallDir "$INSTDIR" -UserDataDir "$PROFILE\AppData\Roaming\clawd-on-desk" -ClawdHome "$PROFILE\.clawd" -CompletionFile "$PLUGINSDIR\clawd-t3-backup-complete"'
+      Pop $R0
+      Pop $R2
+      ${if} $R0 != 0
+        ${if} $LANGUAGE == 2052
+          StrCpy $R3 "Clawd T3 迁移准备未完成，原版程序与配置尚未替换。请从托盘退出所有 Clawd（包括临时测试版）后重试；其他错误请查看下方信息。"
+        ${elseif} $LANGUAGE == 1028
+          StrCpy $R3 "Clawd T3 遷移準備未完成，原版程式與設定尚未替換。請從系統匣結束所有 Clawd（包括臨時測試版）後重試；其他錯誤請查看下方資訊。"
+        ${else}
+          StrCpy $R3 "Clawd T3 migration preparation failed. The original app and settings have not been replaced. Exit all Clawd instances from the tray, including temporary builds, then retry. See details below for other errors."
+        ${endif}
+        MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "$R3$\r$\n$\r$\n$R2" /SD IDCANCEL IDRETRY clawd_t3_backup_retry
+        SetErrorLevel 2
+        Quit
+      ${endif}
+      DetailPrint "$R2"
+    clawd_t3_backup_done:
     !insertmacro CLAWD_CHECK_OLD_INSTALL_REMOVABLE
   !endif
 !macroend
diff --git a/build/t3-migration-backup.ps1 b/build/t3-migration-backup.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..4a6631fe86583a3165bd175dc56e7c6919d69784
--- /dev/null
+++ b/build/t3-migration-backup.ps1
@@ -0,0 +1,153 @@
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory = $true)][string]$InstallDir,
+    [string]$UserDataDir = (Join-Path $env:APPDATA 'clawd-on-desk'),
+    [string]$ClawdHome = (Join-Path $env:USERPROFILE '.clawd'),
+    [string]$BackupRoot = (Join-Path $env:LOCALAPPDATA 'Clawd-T3-Backups'),
+    [string]$CompletionFile,
+    [switch]$PlanOnly
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+function Get-AbsoluteDirectory([string]$Value) {
+    if (-not [IO.Path]::IsPathRooted($Value)) { throw 'Migration paths must be absolute.' }
+    $result = [IO.Path]::GetFullPath($Value).TrimEnd('\', '/')
+    if ($result.Length -le [IO.Path]::GetPathRoot($Value).TrimEnd('\', '/').Length) {
+        throw 'A filesystem root cannot be a migration directory.'
+    }
+    return $result
+}
+
+function Test-Within([string]$Parent, [string]$Candidate) {
+    return $Candidate.Equals($Parent, [StringComparison]::OrdinalIgnoreCase) -or
+        $Candidate.StartsWith($Parent + '\', [StringComparison]::OrdinalIgnoreCase)
+}
+
+function Assert-NoReparsePoints([string]$Directory) {
+    if (-not (Test-Path -LiteralPath $Directory)) { return }
+    $entries = @((Get-Item -LiteralPath $Directory -Force)) + @(Get-ChildItem -LiteralPath $Directory -Recurse -Force)
+    foreach ($entry in $entries) {
+        if (($entry.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
+            throw "Backup stopped at a linked directory or file: $($entry.FullName)"
+        }
+    }
+}
+
+function Get-RunningClawd {
+    # Include a temporary/source build sharing the installed app's userData.
+    # Never stop processes; the installer asks for a normal tray exit instead.
+    return @(Get-CimInstance Win32_Process | Where-Object {
+        ($_.ExecutablePath -and (Test-Within $script:InstallDir $_.ExecutablePath)) -or
+        ($_.CommandLine -and ($_.Name -eq 'Clawd on Desk.exe' -or $_.Name -eq 'electron.exe') -and
+            $_.CommandLine.IndexOf($script:UserDataDir, [StringComparison]::OrdinalIgnoreCase) -ge 0)
+    } | Select-Object -ExpandProperty ProcessId)
+}
+
+function Copy-BackupTree([string]$Source, [string]$Destination) {
+    if (Test-Path -LiteralPath $Source) {
+        Copy-Item -LiteralPath $Source -Destination $Destination -Recurse -Force
+    }
+}
+
+function Get-BackupHash([string]$File) {
+    $stream = [IO.File]::OpenRead($File)
+    $algorithm = [Security.Cryptography.SHA256]::Create()
+    try { return [BitConverter]::ToString($algorithm.ComputeHash($stream)).Replace('-', '') }
+    finally { $stream.Dispose(); $algorithm.Dispose() }
+}
+
+try {
+    $InstallDir = Get-AbsoluteDirectory $InstallDir
+    $UserDataDir = Get-AbsoluteDirectory $UserDataDir
+    $ClawdHome = Get-AbsoluteDirectory $ClawdHome
+    $BackupRoot = Get-AbsoluteDirectory $BackupRoot
+    foreach ($source in @($InstallDir, $UserDataDir, $ClawdHome)) {
+        if ((Test-Within $source $BackupRoot) -or (Test-Within $BackupRoot $source)) {
+            throw 'The backup directory must be separate from the app and its data.'
+        }
+    }
+    if ((Test-Within $InstallDir $UserDataDir) -or (Test-Within $UserDataDir $InstallDir)) {
+        throw 'The app directory and user data must be separate.'
+    }
+    $executable = Join-Path $InstallDir 'Clawd on Desk.exe'
+    $archive = Join-Path $InstallDir 'resources\app.asar'
+    $hasOriginal = Test-Path -LiteralPath $executable
+    if ($hasOriginal) {
+        if (-not (Test-Path -LiteralPath $archive)) { throw 'The existing Clawd installation is incomplete.' }
+        $product = (Get-Item -LiteralPath $executable).VersionInfo.ProductName
+        if ($product -and $product -ne 'Clawd on Desk') { throw 'This is not a Clawd on Desk installation.' }
+    } elseif ((Test-Path -LiteralPath $InstallDir) -and @(Get-ChildItem -LiteralPath $InstallDir -Force).Count -gt 0) {
+        throw 'The selected installation directory contains an unrecognized application.'
+    }
+    $running = @(Get-RunningClawd)
+    if ($PlanOnly) {
+        [ordered]@{
+            installDir = $InstallDir; userDataDir = $UserDataDir; clawdHome = $ClawdHome
+            backupRoot = $BackupRoot; existingInstall = $hasOriginal; runningProcessIds = $running
+            modifiesLiveData = $false
+        } | ConvertTo-Json -Depth 3
+        exit 0
+    }
+    if ($running.Count -gt 0) {
+        throw 'Exit Clawd from its tray menu first, including any temporary/source build. No process was stopped.'
+    }
+    # Validate before copying. No active preferences, hooks, T3 files or registry
+    # entries are written by this helper.
+    foreach ($source in @($InstallDir, $UserDataDir, $ClawdHome)) { Assert-NoReparsePoints $source }
+    if (Test-Path -LiteralPath $BackupRoot) { Assert-NoReparsePoints $BackupRoot }
+    New-Item -ItemType Directory -Path $BackupRoot -Force | Out-Null
+    $backup = Join-Path $BackupRoot ([DateTime]::Now.ToString('yyyyMMdd-HHmmss-fff') + '-' + [guid]::NewGuid().ToString('N').Substring(0, 8))
+    New-Item -ItemType Directory -Path $backup | Out-Null
+    # User data can contain encrypted credentials and configuration. Restrict
+    # this snapshot to the current Windows account and SYSTEM, including copies.
+    $acl = New-Object Security.AccessControl.DirectorySecurity
+    $acl.SetAccessRuleProtection($true, $false)
+    $owner = [Security.Principal.WindowsIdentity]::GetCurrent().User
+    $acl.SetOwner($owner)
+    foreach ($sid in @($owner, (New-Object Security.Principal.SecurityIdentifier('S-1-5-18')))) {
+        $rule = New-Object Security.AccessControl.FileSystemAccessRule($sid, 'FullControl', 'ContainerInherit,ObjectInherit', 'None', 'Allow')
+        $acl.AddAccessRule($rule)
+    }
+    [IO.Directory]::SetAccessControl($backup, $acl)
+    Copy-BackupTree $InstallDir (Join-Path $backup 'original-app')
+    Copy-BackupTree $ClawdHome (Join-Path $backup 'clawd-home')
+    $cacheNames = @('Cache', 'Code Cache', 'GPUCache', 'DawnGraphiteCache', 'DawnWebGPUCache', 'blob_storage', 'Shared Dictionary', 'lockfile')
+    if (Test-Path -LiteralPath $UserDataDir) {
+        $dataBackup = Join-Path $backup 'user-data'
+        New-Item -ItemType Directory -Path $dataBackup | Out-Null
+        foreach ($entry in Get-ChildItem -LiteralPath $UserDataDir -Force) {
+            if ($entry.Name -notin $cacheNames) {
+                Copy-Item -LiteralPath $entry.FullName -Destination $dataBackup -Recurse -Force
+            }
+        }
+    }
+    $checks = @()
+    foreach ($pair in @(
+        @($executable, (Join-Path $backup 'original-app\Clawd on Desk.exe')),
+        @($archive, (Join-Path $backup 'original-app\resources\app.asar')),
+        @((Join-Path $UserDataDir 'clawd-prefs.json'), (Join-Path $backup 'user-data\clawd-prefs.json'))
+    )) {
+        if (Test-Path -LiteralPath $pair[0]) {
+            $sourceHash = Get-BackupHash $pair[0]
+            $copiedHash = Get-BackupHash $pair[1]
+            if ($sourceHash -ne $copiedHash) { throw 'Backup verification failed; installation was not started.' }
+            $checks += [ordered]@{ source = $pair[0]; sha256 = $sourceHash }
+        }
+    }
+    if (@(Get-RunningClawd).Count -gt 0) { throw 'Clawd started during backup. Exit it and retry the installer.' }
+    $manifest = [ordered]@{
+        schemaVersion = 1; createdAt = [DateTime]::UtcNow.ToString('o'); complete = $true
+        installDir = $InstallDir; userDataDir = $UserDataDir; clawdHome = $ClawdHome
+        originalVersion = $(if ($hasOriginal) { (Get-Item -LiteralPath $executable).VersionInfo.FileVersion } else { $null })
+        excludedCaches = $cacheNames; verifiedFiles = $checks; liveDataModified = $false
+    }
+    $manifest | ConvertTo-Json -Depth 6 | Set-Content -LiteralPath (Join-Path $backup 'migration.json') -Encoding UTF8
+    if ($CompletionFile) { Set-Content -LiteralPath $CompletionFile -Value $backup -Encoding UTF8 }
+    Write-Output "Clawd backup verified: $backup"
+    exit 0
+} catch {
+    Write-Output $_.Exception.Message
+    exit 2
+}
