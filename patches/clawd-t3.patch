+"use strict";
+const { it } = require("node:test");
+const assert = require("node:assert/strict");
+const { createT3Interactions } = require("../src/t3-interactions");
+const { classifyPermissionInteraction, evaluatePermissionAutomation } = require("../src/permission-automation-policy");
+const { projectT3Sessions } = require("../src/t3-state-projection");
+const { buildSessionSnapshot } = require("../src/state-session-snapshot");
+
+it("T3's local native callbacks remain manual in every automation mode and do not grant HTTP-hook eligibility", () => {
+  for (const kind of ["t3-question", "t3-approval"]) {
+    const interaction = classifyPermissionInteraction({ agentId:"t3-code", eventKind:kind, toolName:"T3 Code" });
+    for (const mode of ["off", "auto-tools", "unattended"]) assert.equal(evaluatePermissionAutomation({ mode, interaction }), "defer");
+    assert.equal(interaction.automationEligibility.autoTools, false);
+    assert.equal(interaction.automationEligibility.unattended, false);
+  }
+  const hook = classifyPermissionInteraction({ agentId:"t3-code", eventKind:"permission", toolName:"Bash" });
+  assert.equal(hook.capabilities.allowDeny, false);
+});
+
+function fixture() {
+  const cards = new Map(); const calls = []; let suppressed = false;
+  const request = { id:"req", createdAt:"stamp", nodeId:"node", runId:"run", kind:"approval", canRespond:true,
+    options:[{decision:"accept"},{decision:"decline"}], prompt:"test" };
+  const snapshot = { enabled:true, environments:[{id:"remote",connected:true,label:"server",sessions:[
+    {id:"t3:remote:thread",environmentId:"remote",threadId:"thread",pendingRequest:true,title:"Fixture"},
+  ]}] };
+  const bridge = createT3Interactions({
+    runtime:{ inspect:async()=>({requests:[request]}), act:async input=>calls.push(input) },
+    permission:{ showT3Bubble:card=>{cards.set(card.key,card);return true;},removeT3Bubble:key=>{const card=cards.get(key);cards.delete(key);card?.onDismiss?.("upstream");} },
+    isSuppressed:()=>suppressed,
+  });
+  return { bridge,snapshot,request,cards,calls,suppress:()=>{suppressed=true;} };
+}
+
+it("shows and reconciles native request bubbles without generating a decision before an explicit click", async () => {
+  const f=fixture();await f.bridge.sync(f.snapshot);await f.bridge.sync(f.snapshot);
+  assert.equal(f.cards.size,1);assert.equal(f.calls.length,0);
+  const card=[...f.cards.values()][0];await card.submit("allow");
+  assert.deepEqual(f.calls[0],{environmentId:"remote",threadId:"thread",action:"respond",requestId:"req",createdAt:"stamp",nodeId:"node",runId:"run",decision:"accept"});
+});
+
+it("keeps a folded child's approval bound to the child even when its AGY parent shows pending attention", async () => {
+  const f = fixture();
+  const child = f.snapshot.environments[0].sessions[0];
+  Object.assign(child, { live: true, state: "notification", parentThreadId: "parent", relationshipToParent: "subagent" });
+  f.snapshot.environments[0].sessions.unshift({ id: "t3:remote:parent", environmentId: "remote", threadId: "parent",
+    title: "AGY parent", provider: "antigravity", state: "working", live: true, pendingRequest: false });
+  const rows = buildSessionSnapshot(projectT3Sessions(f.snapshot).entries).sessions;
+  assert.equal(rows.find(row => row.id === child.id).hiddenFromHud, true);
+  assert.equal(rows.find(row => row.id === "t3:remote:parent").pendingAttention, true);
+  await f.bridge.sync(f.snapshot);
+  assert.equal(f.cards.size, 1);
+  const card = [...f.cards.values()][0];
+  assert.equal(card.sessionId, child.id);
+  await card.submit("allow");
+  assert.equal(f.calls[0].threadId, "thread");
+  assert.equal(f.calls[0].requestId, "req");
+  assert.equal(f.snapshot.environments[0].sessions[0].pendingRequest, false);
+});
+
+it("maps indexed existing bubble answers back to the exact native question ids", async () => {
+  const f=fixture();f.request.kind="question";f.request.questions=[{id:"native-question",question:"Pick",options:[{label:"A",value:"native-A"}]}];
+  await f.bridge.sync(f.snapshot);const card=[...f.cards.values()][0];
+  assert.equal(card.questions[0].id,"0");
+  await card.submit({type:"elicitation-submit",answers:{"0":{selectedOptionValues:["native-A"],customAnswer:""}}});
+  assert.deepEqual(f.calls[0].answers,{"native-question":{selectedOptionValues:["native-A"],customAnswer:""}});
+});
+
+it("DND, upstream completion, disconnect and shutdown remove cards without answers or denials", async () => {
+  for(const mode of ["dnd","resolved","disconnect","stop"]){
+    const f=fixture();await f.bridge.sync(f.snapshot);
+    if(mode === "dnd")f.suppress();
+    if(mode === "resolved")f.snapshot.environments[0].sessions[0].pendingRequest=false;
+    if(mode === "disconnect")f.snapshot.environments[0].connected=false;
+    if(mode === "stop")f.snapshot.enabled=false;
+    await f.bridge.sync(f.snapshot);assert.equal(f.cards.size,0);assert.deepEqual(f.calls,[]);
+  }
+});
+
+it("an explicitly dismissed request stays dismissed and a prompt bubble sends only typed text", async () => {
+  const f=fixture();await f.bridge.sync(f.snapshot);const card=[...f.cards.values()][0];
+  card.onDismiss("user");f.cards.clear();await f.bridge.sync(f.snapshot);assert.equal(f.cards.size,0);
