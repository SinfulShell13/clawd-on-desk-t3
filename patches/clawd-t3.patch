+  local.threads[1].status = "completed"; local.threads[1].activeRunId = null;
+  await runtime.refresh();
+  snapshot = buildSessionSnapshot(projectT3Sessions(runtime.snapshot()).entries);
+  parent = snapshot.sessions.find(row => row.rawSessionId === "thread" && !row.host);
+  assert.equal(parent.badge, "done");
+  assert.equal(parent.requiresCompletionAck, true);
+});
+
+it("keeps a parent in another environment active for a delegated child and never borrows activity from a fork", async t => {
+  const { runtime, local, remote } = fixture(t);
+  local.threads = [thread({ id: "parent", status: "completed", activeRunId: null }), thread({ id: "fork-parent", status: "completed", activeRunId: null })];
+  remote.threads = [thread({ id: "delegate", delegatedFrom: { environmentId: "local", threadId: "parent" } })];
+  local.threads.push(thread({ id: "fork", lineage: { parentThreadId: "fork-parent", relationshipToParent: "fork" } }));
+  runtime.start(); await runtime.refresh();
+  const rows = buildSessionSnapshot(projectT3Sessions(runtime.snapshot()).entries).sessions;
+  const parent = rows.find(row => row.id === "t3:local:parent");
+  assert.equal(parent.state, "juggling"); assert.equal(parent.activeSubagentCount, 1);
+  assert.equal(rows.find(row => row.id === "t3:remote:delegate").hiddenFromHud, true);
+  assert.equal(rows.find(row => row.id === "t3:local:fork-parent").t3.live, false);
+  assert.equal(rows.find(row => row.id === "t3:local:fork").hiddenFromHud, false);
+});
+
+it("reuses linked environments and sends an approval only to the explicitly selected environment", async t => {
+  const { runtime, local, remote } = fixture(t);
+  runtime.start(); await runtime.refresh();
+  assert.equal(runtime.snapshot().environments.length, 2);
+  assert.deepEqual(local.commands, []); assert.deepEqual(remote.commands, []);
+  await runtime.act(approval);
+  assert.equal(local.commands.length, 0); assert.equal(remote.commands.length, 1);
+  assert.equal(remote.commands[0].type, "runtime-request.respond");
+  assert.equal(remote.commands[0].requestId, "request");
+  assert.equal(remote.commands[0].decision, "accept");
+  await runtime.stop();
+  assert.equal(remote.commands.length, 1);
+});
+
+it("rejects stale request identities, completed requests and persistent grants without dispatching", async t => {
+  const { runtime, remote } = fixture(t);
+  runtime.start(); await runtime.refresh();
+  for (const changed of [{ requestId: "old" }, { nodeId: "old" }, { runId: "old" }, { createdAt: "old" }]) {
+    await assert.rejects(runtime.act({ ...approval, ...changed }), /T3_REQUEST_STALE/);
+  }
+  await assert.rejects(runtime.act({ ...approval, decision: "acceptAlways" }), /T3_INVALID_DECISION/);
+  remote.projectionValue.runtimeRequests[0].status = "resolved";
+  await assert.rejects(runtime.act(approval), /T3_REQUEST_STALE/);
+  assert.deepEqual(remote.commands, []);
+});
+
+it("answers the fresh question using native option values, text and ordered multiple selections", async t => {
+  const { runtime, remote } = fixture(t);
+  remote.projectionValue.runtimeRequests[0].kind = "user_input";
+  remote.projectionValue.turnItems = [{ type: "user_input_request", requestId: "request", questions: [
+    { id: "choice", question: "Pick", options: [{ label: "First", value: " native " }], allowCustomAnswer: false },
+    { id: "text", question: "Why?", options: [] },
+    { id: "many", question: "Select", multiSelect: true, options: [{ label: "A" }, { label: "B" }] },
+  ] }];
+  runtime.start(); await runtime.refresh();
+  await runtime.act({ ...approval, decision: undefined, answers: {
+    choice: { selectedOptionValues: [" native "] }, text: { customAnswer: "  Because  " }, many: { selectedOptionValues: ["B", "A"] },
+  } });
+  assert.deepEqual(remote.commands[0].answers, { choice: " native ", text: "Because", many: ["B", "A"] });
+  assert.equal(remote.commands[0].decision, undefined);
+  assert.throws(() => answersOf([{ id: "q", options: [], allowCustomAnswer: false }], { q: { customAnswer: "not allowed" } }), /T3_INVALID_ANSWER/);
+  assert.throws(() => answersOf([{ id: "q", options: [{ label: "A" }] }], { q: { selectedOptionValues: ["unknown"] } }), /T3_INVALID_ANSWER/);
+});
+
+it("leaves secret, link, elicitation and nonresumable requests in T3", () => {
+  const p = projection();
+  p.runtimeRequests[0].kind = "mcp-elicitation";
+  assert.equal(requestsOf(p)[0].canRespond, false);
+  p.runtimeRequests[0].kind = "command";
+  p.runtimeRequests[0].responseCapability = { type: "not_resumable" };
+  assert.equal(requestsOf(p)[0].canRespond, false);
+});
+
+it("interrupts only the selected live run and holds the queue; a new run never replaces the target", async t => {
+  const { runtime, remote } = fixture(t);
+  runtime.start(); await runtime.refresh();
+  await runtime.act({ environmentId: "remote", threadId: "thread", action: "interrupt", runId: "run" });
+  assert.equal(remote.commands[0].runId, "run"); assert.equal(remote.commands[0].holdQueue, true);
+  remote.projectionValue.runs = [{ id: "run", status: "completed" }, { id: "new-run", status: "running" }];
+  await assert.rejects(runtime.act({ environmentId: "remote", threadId: "thread", action: "interrupt", runId: "run" }), /T3_RUN_STALE/);
+  assert.equal(remote.commands.length, 1);
+});
+
+it("queues prompts on busy sessions, starts idle ones, and binds steering to the selected run", async t => {
+  const { runtime, remote } = fixture(t);
+  runtime.start(); await runtime.refresh();
+  const send = { environmentId: "remote", threadId: "thread", action: "send", text: "Test prompt" };
+  await runtime.act(send);
+  assert.deepEqual(remote.commands.at(-1).dispatchMode, { type: "queue_after_active" });
+  await assert.rejects(runtime.act({ ...send, mode: "steer", runId: "old" }), /T3_RUN_STALE/);
+  await runtime.act({ ...send, mode: "steer", runId: "run" });
+  assert.deepEqual(remote.commands.at(-1).dispatchMode, { type: "steer_active", targetRunId: "run" });
+  remote.projectionValue.runs = [];
+  await runtime.act(send);
+  assert.deepEqual(remote.commands.at(-1).dispatchMode, { type: "start_immediately" });
+  assert.equal(new Set(remote.commands.map(command => command.commandId)).size, 3);
+});
+
+it("never retries a mutation after an unknown result and rejects overlapping submissions", async t => {
+  const { runtime, remote } = fixture(t);
+  runtime.start(); await runtime.refresh();
+  remote.failDispatch = true;
+  await assert.rejects(runtime.act(approval), /unknown result/);
+  await runtime.refresh();
+  assert.equal(remote.commands.length, 1);
+  let finish;
+  remote.dispatch = () => new Promise(resolve => { finish = resolve; });
+  const pending = runtime.act(approval);
+  await assert.rejects(runtime.act(approval), /T3_ACTION_BUSY/);
+  finish({ sequence: 2 }); await pending;
+});
+
+it("disconnects and unlinks without creating decisions; cached rows become offline and actions are blocked", async t => {
+  const { runtime, local, remote, advance } = fixture(t);
+  runtime.start(); await runtime.refresh();
+  remote.fail = true;
+  await runtime.refresh();
+  assert.equal(runtime.snapshot().environments.find(env => env.id === "remote").sessions[0].state, "sleeping");
+  await assert.rejects(runtime.act(approval), /T3_DISCONNECTED/);
+  remote.fail = false; local.links = []; advance();
+  await runtime.refresh();
+  assert.equal(runtime.snapshot().environments.length, 1);
+  assert.equal(remote.closes, 1); assert.deepEqual(remote.commands, []);
+});
+
+it("does not dispatch if stopped while refreshing a request", async t => {
+  const { runtime, remote } = fixture(t);
+  runtime.start(); await runtime.refresh();
+  let finish;
+  remote.projection = () => new Promise(resolve => { finish = resolve; });
+  const pending = runtime.act(approval);
+  await runtime.stop();
+  finish(projection());
+  await assert.rejects(pending, /T3_DISCONNECTED/);
+  assert.deepEqual(remote.commands, []);
+});
+
+it("keeps a parent working while it waits for delegated work even after its latest run completed", () => {
+  assert.equal(stateOf(thread({ status: "waiting", activeRunId: null, latestRunId: "completed-run", blockedOnThreadWait: true })), "working");
+  assert.equal(stateOf(thread({ status: "completed", pendingBackgroundTasks: [{ id: "child" }] })), "working");
+  assert.equal(stateOf(thread({ pendingRuntimeRequest: { id: "q" } })), "notification");
+  assert.equal(stateOf(thread({ pendingRuntimeRequest: { id: "q", blocking: false } })), "working");
+});
diff --git a/test/t3-state-projection.test.js b/test/t3-state-projection.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..0880c732a936cd7dd5a159ca6676848b81ee1ffe
--- /dev/null
+++ b/test/t3-state-projection.test.js
@@ -0,0 +1,150 @@
+"use strict";
+const { it } = require("node:test");
+const assert = require("node:assert/strict");
+const { projectT3Sessions, mergeT3Sessions } = require("../src/t3-state-projection");
+const { buildSessionSnapshot, sessionSnapshotSignature } = require("../src/state-session-snapshot");
+const { getSessionFocusTarget } = require("../src/session-focus");
+const { keyOf, threadUrl } = require("../src/t3-links");
+const fs = require("node:fs");
+const path = require("node:path");
+const vm = require("node:vm");
+
+it("propagates per-environment icons and broadcasts icon-only changes without changing provider icons", () => {
+  const env = { id: "remote", label: "Machine", connected: true, environmentIcon: "linux", sessions: [
+    { id: keyOf("remote", "thread"), threadId: "thread", provider: "codex", title: "Same title", state: "working", live: true,
+      url: threadUrl("remote", "thread") },
+  ] };
+  const build = () => buildSessionSnapshot(projectT3Sessions({ environments: [env] }).entries, { getAgentIconUrl: id => `icon:${id}` });
+  const before = build(); env.environmentIcon = "desktop"; const after = build();
+  assert.equal(before.sessions[0].t3.environmentIcon, "linux");
+  assert.equal(after.sessions[0].t3.environmentIcon, "desktop");
+  assert.equal(after.sessions[0].iconUrl, "icon:codex");
+  assert.equal(after.sessions[0].focusTarget.url, "t3code://threads/remote/thread");
+  assert.notEqual(sessionSnapshotSignature(before), sessionSnapshotSignature(after));
+});
+
+it("uses provider icons for T3 sessions without changing their agent identity or native focus target", () => {
+  const env = { id: "remote", label: "server", connected: true, sessions: [] };
+  const providers = ["codex", "claudeAgent", "antigravity", "opencode"];
+  env.sessions = providers.map(provider => ({ id: keyOf(env.id, provider), threadId: provider,
+    provider, title: "Same title", model: "Same model", state: "working", live: true,
+    url: threadUrl(env.id, provider) }));
+  const rows = buildSessionSnapshot(projectT3Sessions({ environments: [env] }).entries, {
+    getAgentIconUrl: agent => `icon:${agent}`,
+  }).sessions;
+  assert.deepEqual(rows.map(row => row.iconUrl), ["icon:codex", "icon:claude-code", "icon:antigravity-cli", "icon:opencode"]);
+  assert.ok(rows.every(row => row.agentId === "t3-code" && row.focusTarget.type === "t3-thread" && row.host === "server"));
+});
+
+it("uses the real driver for custom instances and falls back to T3 for unknown providers", () => {
+  const make = (provider, providerDriver) => ({ id: "t3:local:thread", threadId: "thread", provider, providerDriver,
+    title: "Codex", model: "gpt-fixture", state: "working", live: true, url: threadUrl("local", "thread") });
+  const row = thread => buildSessionSnapshot(projectT3Sessions({ environments: [{ id: "local", local: true, connected: true, sessions: [thread] }] }).entries,
+    { getAgentIconUrl: agent => `icon:${agent}` }).sessions[0];
+  const custom = row(make("work", "claudeAgent"));
+  assert.equal(custom.iconUrl, "icon:claude-code");
+  assert.equal(custom.agentName, "T3 Code · Claude Code");
+  assert.equal(row(make("codex", "unrecognized-driver")).iconUrl, "icon:t3-code");
+  assert.equal(row(make("my-codex-instance")).iconUrl, "icon:t3-code");
+  assert.equal(row(make("../codex")).iconUrl, "icon:t3-code");
+});
+
+it("broadcasts a provider-only change even when a T3 session's title and state stay the same", () => {
+  const entry = { agentId: "t3-code", provider: "custom", state: "working", t3Url: threadUrl("local", "thread"),
+    t3: { environmentId: "local", threadId: "thread", providerDriver: "claudeAgent", live: true } };
+  const before = buildSessionSnapshot(new Map([["t3:local:thread", entry]]), { getAgentIconUrl: agent => `icon:${agent}` });
+  const after = buildSessionSnapshot(new Map([["t3:local:thread", { ...entry, t3: { ...entry.t3, providerDriver: "codex" } }]]),
+    { getAgentIconUrl: agent => `icon:${agent}` });
+  assert.equal(before.sessions[0].iconUrl, "icon:claude-code");
+  assert.equal(after.sessions[0].iconUrl, "icon:codex");
+  assert.notEqual(sessionSnapshotSignature(before), sessionSnapshotSignature(after));
+});
+
+it("deduplicates only proven provider identities on the matching host and preserves canonical hook sessions", () => {
+  const id = keyOf("remote", "thread");
+  const snapshot = { environments: [{ id: "remote", label: "server", local: false, connected: true, sessions: [
+    { id, threadId: "thread", title: "T3 title", state: "working", updatedAt: "2026-11-21T00:00:00Z", url: threadUrl("remote", "thread") },
+  ] }] };
+  const native = new Map([
+    ["same", { agentId: "codex", rawSessionId: "native", host: "server", state: "working" }],
+    ["other-host", { agentId: "codex", rawSessionId: "native", host: null, state: "working" }],
+    ["same-directory", { agentId: "codex", rawSessionId: "unrelated", host: "server", state: "working" }],
+  ]);
+  const projection = projectT3Sessions(snapshot, new Map([[id, [{ driver: "codex", id: "native" }]]]));
+  const merged = mergeT3Sessions(native, projection);
+  assert.equal(merged.has("same"), false); assert.equal(native.has("same"), true);
+  assert.equal(merged.has("other-host"), true); assert.equal(merged.has("same-directory"), true);
+  const entry = merged.get(id);
+  assert.equal(getSessionFocusTarget({ id, ...entry }).url, "t3code://threads/remote/thread");
+  const state = buildSessionSnapshot(new Map([[id, entry]]));
+  assert.deepEqual(state.sessions[0].t3, { environmentId: "remote", threadId: "thread", connected: true, pending: false, live: true, hudVisible: true, activeSubagentCount: 0, aggregated: false, parentSessionId: null });
+  assert.equal(state.sessions[0].contextUsage, null);
+  snapshot.environments[0].connected = false;
+  const offline = projectT3Sessions(snapshot, new Map([[id, [{ driver: "codex", id: "native" }]]]));
+  assert.equal(mergeT3Sessions(native, offline).has("same"), true);
+  assert.notEqual(sessionSnapshotSignature(state), sessionSnapshotSignature(buildSessionSnapshot(offline.entries)));
+});
+
+it("includes T3-only work in the real main-process busy predicate used by keep-awake and idle behavior", () => {
+  const source = fs.readFileSync(path.join(__dirname, "../src/main.js"), "utf8");
+  const start = source.indexOf("function anySessionInProgress()");
+  const end = source.indexOf("function reconcilePowerSaveBlocker()", start);
+  const projected = new Map([["t3:env:thread", { state: "working", agentId: "t3-code" }]]);
+  const predicate = vm.runInNewContext(`${source.slice(start, end)}; anySessionInProgress`, {
+    _state: { hasActiveCodexSubagents: () => false, hasActiveQoderSubagents: () => false, getSessionPresentationSessions: () => projected },
+    sessions: new Map(), isSessionInProgress: require("../src/state-session-snapshot").isSessionInProgress,
+  });
+  assert.equal(predicate(), true);
+  projected.values().next().value.state = "idle";
+  assert.equal(predicate(), false);
+});
+
+it("folds a Codex delegate under its AGY parent while keeping an ordinary fork independent", () => {
+  const env = { id: "remote", label: "Remote fixture", local: false, connected: true, sessions: [] };
+  const session = (threadId, extra = {}) => ({ id: keyOf(env.id, threadId), threadId, title: threadId,
+    state: "working", status: "running", live: true, hudVisible: true,
+    provider: "codex", url: threadUrl(env.id, threadId), ...extra });
+  env.sessions = [session("agy", { provider: "antigravity", parentThreadId: null }),
+    session("delegate", { parentThreadId: "agy", relationshipToParent: "subagent" }),
+    session("fork", { parentThreadId: "agy", relationshipToParent: "fork" })];
+  const rows = buildSessionSnapshot(projectT3Sessions({ environments: [env] }).entries).sessions;
+  const child = rows.find(row => row.rawSessionId === "delegate");
+  const parent = rows.find(row => row.rawSessionId === "agy");
+  assert.equal(child.hiddenFromHud, true, "a delegated Codex run belongs to the parent HUD row");
+  assert.equal(child.canFocus, true, "its own thread remains available in Dashboard");
+  assert.equal(parent.activeSubagentCount, 1);
+  assert.equal(parent.state, "juggling");
+  assert.equal(rows.find(row => row.rawSessionId === "fork").hiddenFromHud, false);
+});
+
+it("folds Codex-to-Codex subagents at every level without depending on the provider name", () => {
+  const env = { id: "local", local: true, connected: true, sessions: [] };
+  const session = (threadId, parentThreadId = null) => ({ id: keyOf(env.id, threadId), threadId,
+    provider: "codex", state: "working", status: "running", live: true, hudVisible: true,
+    url: threadUrl(env.id, threadId), parentThreadId, relationshipToParent: parentThreadId ? "subagent" : null });
+  env.sessions = [session("codex-parent"), session("codex-child", "codex-parent"), session("codex-grandchild", "codex-child")];
+  const rows = buildSessionSnapshot(projectT3Sessions({ environments: [env] }).entries).sessions;
+  assert.deepEqual(rows.filter(row => !row.hiddenFromHud).map(row => row.rawSessionId), ["codex-parent"]);
+  assert.equal(rows.find(row => row.rawSessionId === "codex-parent").activeSubagentCount, 2);
+  assert.equal(rows.find(row => row.rawSessionId === "codex-child").activeSubagentCount, 1);
+  assert.ok(rows.every(row => row.canFocus), "each child remains available through the original Dashboard");
+});
+
+it("raises a child's pending input on its parent without hiding orphaned or disconnected-parent work", () => {
+  const session = (environmentId, threadId, extra = {}) => ({ id: keyOf(environmentId, threadId), threadId,
+    state: "working", status: "running", live: true, hudVisible: true, url: threadUrl(environmentId, threadId), ...extra });
+  const parentEnv = { id: "local", local: true, connected: true, sessions: [session("local", "parent")] };
+  const childEnv = { id: "remote", local: false, label: "Remote fixture", connected: true, sessions: [
+    session("remote", "child", { delegatedFrom: { environmentId: "local", threadId: "parent" }, pendingRequest: true }),
+    session("remote", "orphan", { parentThreadId: "missing", relationshipToParent: "subagent" }),
+  ] };
+  let rows = buildSessionSnapshot(projectT3Sessions({ environments: [parentEnv, childEnv] }).entries).sessions;
+  const parent = rows.find(row => row.id === "t3:local:parent");
+  assert.equal(parent.pendingAttention, true);
+  assert.equal(parent.state, "notification");
+  assert.equal(rows.find(row => row.id === "t3:remote:child").hiddenFromHud, true);
+  assert.equal(rows.find(row => row.id === "t3:remote:orphan").hiddenFromHud, false);
+  parentEnv.connected = false;
+  rows = buildSessionSnapshot(projectT3Sessions({ environments: [parentEnv, childEnv] }).entries).sessions;
+  assert.equal(rows.find(row => row.id === "t3:remote:child").hiddenFromHud, false, "work stays reachable when its parent environment is unavailable");
+});
