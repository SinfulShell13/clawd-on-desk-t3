index 0000000000000000000000000000000000000000..cf8660fa48177fc5fb34105f2721745eed9bb2b4
--- /dev/null
+++ b/src/t3-interactions.js
@@ -0,0 +1,82 @@
+"use strict";
+
+function indexedQuestions(questions) {
+  return questions.map((question, i) => ({ ...question, id: String(i), allowOther: question.allowCustomAnswer !== false }));
+}
+
+function createT3Interactions({ runtime, permission, isSuppressed = () => false }) {
+  const shown = new Map();
+  const dismissed = new Set();
+  let generation = 0;
+  function clear() {
+    generation++;
+    for (const key of shown.keys()) permission.removeT3Bubble(key);
+    shown.clear();
+  }
+  async function sync(snapshot) {
+    const epoch = ++generation;
+    if (!snapshot.enabled || isSuppressed()) { clear(); return; }
+    const live = new Set();
+    const pending = snapshot.environments.filter(env => env.connected).flatMap(env =>
+      env.sessions.filter(session => session.pendingRequest).map(session => ({ env, session })));
+    for (const { env, session } of pending) {
+      let detail;
+      try { detail = await runtime.inspect(env.id, session.threadId); } catch { continue; }
+      if (epoch !== generation) return;
+      for (const request of detail.requests) {
+        if (!request.canRespond) continue;
+        if (request.kind === "approval" && !["accept", "decline"].every(decision => request.options.some(option => option.decision === decision))) continue;
+        const key = JSON.stringify([env.id, session.threadId, request.id, request.createdAt]);
+        live.add(key);
+        if (shown.has(key) || dismissed.has(key)) continue;
+        const visible = permission.showT3Bubble({
+          key, sessionId: session.id, title: session.title, host: env.local ? null : env.label,
+          prompt: request.prompt,
+          questions: request.kind === "question" ? indexedQuestions(request.questions) : null,
+          submit: async behavior => {
+            const input = { environmentId: env.id, threadId: session.threadId, action: "respond", requestId: request.id,
+              createdAt: request.createdAt, nodeId: request.nodeId, runId: request.runId };
+            if (request.kind === "question") {
+              if (behavior?.type !== "elicitation-submit") throw new Error("T3_INVALID_ANSWER");
+              input.answers = Object.fromEntries(request.questions.map((question, i) => [question.id, behavior.answers?.[String(i)]]));
+            } else {
+              if (!["allow", "deny"].includes(behavior)) throw new Error("T3_INVALID_DECISION");
+              input.decision = behavior === "allow" ? "accept" : "decline";
+            }
+            await runtime.act(input);
+          },
+          onDismiss: reason => {
+            shown.delete(key);
+            if (["user", "submitted"].includes(reason)) {
+              dismissed.add(key);
+              if (dismissed.size > 200) dismissed.delete(dismissed.values().next().value);
+            }
+          },
+        });
+        if (visible) shown.set(key, session.id);
+      }
+    }
+    if (epoch !== generation) return;
+    for (const key of [...shown.keys()]) if (!live.has(key) && !key.startsWith("prompt:")) {
+      permission.removeT3Bubble(key);
+      shown.delete(key);
+    }
+  }
+  function prompt(session) {
+    const key = `prompt:${session.id}`;
+    const visible = permission.showT3Bubble({
+      key, sessionId: session.id, title: session.title,
+      questions: [{ id: "0", header: "T3 Code", question: "发送提示 / Send a prompt", options: [], allowOther: true }],
+      submit: async behavior => {
+        const text = behavior?.answers?.["0"]?.customAnswer;
+        await runtime.act({ environmentId: session.environmentId, threadId: session.threadId, action: "send", text, mode: "queue" });
+      },
+      onDismiss: () => shown.delete(key),
+    });
+    if (visible) shown.set(key, session.id);
+    return visible;
+  }
+  return { sync, clear, prompt };
+}
+
+module.exports = { createT3Interactions, indexedQuestions };
