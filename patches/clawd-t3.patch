+  remote.setProvider("codex","codex");await runtime.refresh();
+  await wait(hud,"[...document.querySelectorAll('.row')].find(r=>r.querySelector('.title')?.textContent.includes('Codex 远端'))?.querySelector('.agent-icon')?.src.endsWith('/agents/codex.png')");
+  let next=once(events,"opened");
+  await hud.executeJavaScript("[...document.querySelectorAll('.row')].find(r=>r.querySelector('.title')?.textContent.includes('Codex 远端')).click()");await next;
+  assert.equal(opened.at(-1),"t3code://threads/remote-fixture/codex");
+  const folder = await dashboard.executeJavaScript("window.dashboardAPI.openSessionFolder('t3:local-fixture:agy')");
+  assert.equal(folder.status,"ok");assert.equal(openedFolders[0],fixtureFolder);
