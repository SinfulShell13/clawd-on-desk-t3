--- /dev/null
+++ b/src/t3-client.js
@@ -0,0 +1,248 @@
+"use strict";
+
+const fs = require("node:fs/promises");
+const path = require("node:path");
+const os = require("node:os");
+const { execFile } = require("node:child_process");
+const WebSocket = require("ws");
+const { createDpopSigner } = require("./t3-dpop");
+const { resolveT3EnvironmentIcon } = require("./t3-environment-icons");
+
+const SCOPES = ["orchestration:read", "orchestration:operate", "access:read", "access:write"];
+const HOME = process.env.T3CODE_HOME || path.join(os.homedir(), ".t3");
+
+function t3Error(code) {
+  const error = new Error(code);
+  error.code = code;
+  return error;
+}
+
+function validOrigin(value, local = false) {
+  const url = new URL(value);
+  if (!["http:", "https:"].includes(url.protocol) || url.username || url.password
+    || url.search || url.hash || url.pathname !== "/"
+    || (local && !["127.0.0.1", "localhost", "[::1]"].includes(url.hostname))) {
+    throw t3Error("T3_INVALID_ORIGIN");
+  }
+  return url.origin;
+}
+
+async function jsonRequest(origin, route, token, options = {}) {
+  const response = await fetch(`${origin}${route}`, {
+    ...options,
+    redirect: "error",
+    signal: options.signal || AbortSignal.timeout(15000),
+    headers: {
+      "x-t3-orchestration-protocol": "2",
+      ...(token ? { authorization: `Bearer ${token}` } : {}),
+      ...options.headers,
+    },
+  });
+  if (!response.ok) {
+    await response.body?.cancel();
+    throw t3Error(`T3_HTTP_${response.status}`);
+  }
+  const chunks = [];
+  let bytes = 0;
+  for await (const chunk of response.body) {
+    bytes += chunk.length;
+    if (bytes > 32 * 1024 * 1024) throw t3Error("T3_RESPONSE_TOO_LARGE");
+    chunks.push(chunk);
+  }
+  try { return JSON.parse(Buffer.concat(chunks).toString("utf8")); }
+  catch { throw t3Error("T3_INVALID_RESPONSE"); }
+}
+
+async function runCli(args, home = HOME) {
+  let file = process.env.T3CODE_CLI_PATH || path.join(os.homedir(), ".t3", "bin", process.platform === "win32" ? "t3.cmd" : "t3");
+  let prefix = [];
+  const env = { ...process.env, T3CODE_HOME: home };
+  if (process.platform === "win32") {
+    // Read only the official desktop launcher shape; never evaluate a .cmd or interpolate a shell command.
+    const launcher = await fs.readFile(file, "utf8");
+    const match = launcher.match(/^"([^"\r\n]+\.exe)" "([^"\r\n]+\\server\.asar\\apps\\server\\dist\\bin\.mjs)" %\*\s*$/m);
+    if (!match) throw t3Error("T3_CLI_UNSUPPORTED");
+    file = match[1];
+    prefix = [match[2]];
+    env.ELECTRON_RUN_AS_NODE = "1";
+    env.T3CODE_DESKTOP_CLI_LAUNCHER = "1";
+  } else {
+    delete env.ELECTRON_RUN_AS_NODE;
+  }
+  return new Promise((resolve, reject) => {
+    execFile(file, [...prefix, ...args, "--base-dir", home], {
+      env, windowsHide: true, timeout: 20000, maxBuffer: 1024 * 1024,
+    }, (error, stdout) => {
+      if (error) reject(t3Error("T3_CLI_FAILED"));
+      else resolve(stdout);
+    });
+  });
+}
+
+class T3Rpc {
+  constructor(socket, timeoutMs = 15000) {
+    this.socket = socket;
+    this.timeoutMs = timeoutMs;
+    this.pending = new Map();
+    this.sequence = 0;
+    socket.on("message", data => {
+      try {
+        const decoded = JSON.parse(data.toString());
+        for (const message of Array.isArray(decoded) ? decoded : [decoded]) this.receive(message);
+      } catch { this.close(); }
+    });
+    socket.on("error", () => this.fail());
+    socket.on("close", () => this.fail());
+  }
+  receive(message) {
+    if (message._tag === "Ping") { this.socket.send(JSON.stringify({ _tag: "Pong" })); return; }
+    const entry = this.pending.get(String(message.requestId));
+    if (!entry) return;
+    if (message._tag === "Exit") {
+      clearTimeout(entry.timer);
+      this.pending.delete(String(message.requestId));
+      if (message.exit?._tag === "Success") entry.resolve(message.exit.value);
+      else entry.reject(t3Error("T3_RPC_REFUSED"));
+    }
+  }
+  call(tag, payload) {
+    if (this.socket.readyState !== WebSocket.OPEN) return Promise.reject(t3Error("T3_DISCONNECTED"));
+    const id = String(++this.sequence);
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => {
+        this.pending.delete(id);
+        reject(t3Error("T3_RPC_OUTCOME_UNKNOWN"));
+      }, this.timeoutMs);
+      this.pending.set(id, { resolve, reject, timer });
+      this.socket.send(JSON.stringify({ _tag: "Request", id, tag, payload, headers: [] }));
+    });
+  }
+  fail() {
+    for (const entry of this.pending.values()) {
+      clearTimeout(entry.timer);
+      entry.reject(t3Error("T3_DISCONNECTED"));
+    }
+    this.pending.clear();
+  }
+  close() { this.fail(); this.socket.close(); }
+}
+
+class T3Client {
+  constructor({ origin, token, expiresAt, sessionId, home, ownedLocal = false, request = jsonRequest, signer }) {
+    this.origin = validOrigin(origin);
+    this.token = token;
+    this.expiresAt = expiresAt;
+    this.sessionId = sessionId;
+    this.home = home;
+    this.ownedLocal = ownedLocal;
+    this.signer = signer;
+    this.request = (origin, route, token, options = {}) => request(origin, route, token, {
+      ...options,
+      ...(this.signer && token ? { headers: {
+        ...options.headers, authorization: `DPoP ${token}`,
+        dpop: this.signer(options.method || "GET", `${origin}${route}`, token),
+      } } : {}),
+    });
+    this.rpc = null;
+    this.connecting = null;
