+      // on an old conversation. A zero timeout retains observed turns forever
+      // without importing the entire history at startup.
+      else if (Number.isFinite(at) && at <= now() && now() - at <= (retention() || SESSION_STALE_MS)) record.completedAt = at;
+    }
+    record.live = live;
+  }
+  function presentation(id, status) {
+    const record = records.get(id);
+    if (!record) return { hudVisible: false, dismissed: false, requiresCompletionAck: false, completedAt: null };
+    const recent = record.completedAt !== null && (retention() === 0 || now() - record.completedAt <= retention());
+    const hudVisible = !record.dismissed && (record.live || recent);
+    return { hudVisible, dismissed: record.dismissed, completedAt: record.completedAt,
+      requiresCompletionAck: hudVisible && !record.live && status === "completed" && !record.acknowledged };
+  }
+  function ack(id) {
+    const record = records.get(id);
+    if (!record || record.dismissed || record.live || record.completedAt === null || record.acknowledged) return false;
+    record.acknowledged = true;
+    return true;
+  }
+  function dismiss(id) {
+    const record = records.get(id);
+    if (!record || record.dismissed) return false;
+    record.dismissed = true;
+    return true;
+  }
+  function prune(ids) { for (const id of records.keys()) if (!ids.has(id)) records.delete(id); }
+  return { observe, presentation, ack, dismiss, prune, clear: () => records.clear() };
+}
+
+module.exports = { createT3SessionLifecycle };
diff --git a/src/t3-state-projection.js b/src/t3-state-projection.js
new file mode 100644
index 0000000000000000000000000000000000000000..bfe0c0821f42a830d96064f64b73066c0f17023d
--- /dev/null
+++ b/src/t3-state-projection.js
@@ -0,0 +1,70 @@
+"use strict";
+
+const DRIVER_AGENT = { codex: "codex", opencode: "opencode", antigravity: "antigravity-cli", claude: "claude-code" };
+const { createT3ThreadGraph } = require("./t3-thread-relations");
+
+function projectT3Sessions(snapshot, nativeRefs = new Map()) {
+  const entries = new Map();
+  const claims = [];
+  const graph = createT3ThreadGraph(snapshot.environments);
+  const childCounts = new Map();
+  const childAttention = new Set();
+  for (const { id, environment, thread } of graph.byId.values()) if (environment.connected && thread.live) {
+    for (const parent of graph.ancestorsOf(id)) {
+      childCounts.set(parent, (childCounts.get(parent) || 0) + 1);
+      if (thread.pendingRequest) childAttention.add(parent);
+    }
+  }
+  for (const env of snapshot.environments) {
+    for (const thread of env.sessions) {
+      const activeSubagentCount = childCounts.get(thread.id) || 0;
+      const pendingAttention = thread.pendingRequest || childAttention.has(thread.id);
+      const aggregated = graph.ancestorsOf(thread.id).some(parent => graph.byId.get(parent).environment.connected);
+      const event = pendingAttention ? "PermissionRequest" : thread.live ? "T3" : thread.status === "completed" ? "Stop"
+        : ["interrupted", "failed", "cancelled"].includes(thread.status) ? "StopFailure" : "T3";
+      const at = (!thread.live && thread.completedAt) || Date.parse(thread.updatedAt) || 0;
+      if (!thread.dismissed) entries.set(thread.id, {
+        agentId: "t3-code", rawSessionId: thread.threadId, sessionTitle: thread.title,
+        state: env.connected && childAttention.has(thread.id) ? "notification"
+          : env.connected && activeSubagentCount > 0 ? "juggling"
+          : env.connected && thread.live === false && ["failed", "interrupted", "cancelled"].includes(thread.status) ? "idle" : thread.state,
+        host: env.local ? null : env.label, profileId: "local",
+        cwd: thread.cwd, updatedAt: at, model: thread.model, provider: thread.provider,
+        recentEvents: [{ event, at }],
+        requiresCompletionAck: thread.requiresCompletionAck === true && activeSubagentCount === 0,
+        t3: { environmentId: env.id, threadId: thread.threadId,
+          ...(env.environmentIcon ? { environmentIcon: env.environmentIcon } : {}),
+          ...(thread.providerDriver ? { providerDriver: thread.providerDriver } : {}),
+          connected: env.connected, pending: pendingAttention || false,
+          live: thread.live !== false, hudVisible: !aggregated && (thread.hudVisible ?? thread.live !== false), activeSubagentCount,
+          aggregated, parentSessionId: graph.parentIds.get(thread.id) || null },
+        // A native link remains useful even if the server is temporarily offline.
+        t3Url: thread.url,
+      });
+      if (env.connected) {
+        for (const ref of nativeRefs.get(thread.id) || []) {
+          if (DRIVER_AGENT[ref.driver]) claims.push({
+            agentId: DRIVER_AGENT[ref.driver], nativeId: ref.id, host: env.local ? null : env.label,
+          });
+        }
+      }
+    }
+  }
+  return { entries, claims };
+}
+
+function mergeT3Sessions(sessions, projection) {
+  if (!projection.entries.size && !projection.claims.length) return sessions;
+  const merged = new Map();
+  for (const [id, session] of sessions) {
+    const rawId = session.rawSessionId || id;
+    const duplicate = projection.claims.some(claim => claim.agentId === session.agentId
+      && claim.host === (session.host || null)
+      && (rawId === claim.nativeId || rawId === `${session.agentId}:${claim.nativeId}`));
+    if (!duplicate) merged.set(id, session);
+  }
+  for (const [id, entry] of projection.entries) merged.set(id, entry);
+  return merged;
+}
+
+module.exports = { projectT3Sessions, mergeT3Sessions };
diff --git a/src/t3-thread-relations.js b/src/t3-thread-relations.js
new file mode 100644
index 0000000000000000000000000000000000000000..1fd6be23ec1c0067510424d7085d6e852ee60f28
--- /dev/null
+++ b/src/t3-thread-relations.js
@@ -0,0 +1,42 @@
+"use strict";
+
+const { keyOf } = require("./t3-links");
+
+function parentKeyOf(environmentId, thread) {
+  const delegated = thread.delegatedFrom;
+  if (typeof delegated?.environmentId === "string" && delegated.environmentId
+    && typeof delegated.threadId === "string" && delegated.threadId) {
+    return keyOf(delegated.environmentId, delegated.threadId);
+  }
+  const lineage = thread.lineage || thread;
+  return lineage.relationshipToParent === "subagent" && typeof lineage.parentThreadId === "string" && lineage.parentThreadId
+    ? keyOf(environmentId, lineage.parentThreadId) : null;
+}
+
+// Both the raw shell and its normalized snapshot carry T3's explicit lineage.
+// A fork is an independent conversation; provider/title/cwd never prove a child.
+function createT3ThreadGraph(environments) {
+  const byId = new Map();
+  const parentIds = new Map();
+  for (const environment of environments) for (const thread of environment.threads || environment.sessions || []) {
+    const id = keyOf(environment.id, thread.threadId || thread.id);
+    byId.set(id, { id, environment, thread });
+    const parent = parentKeyOf(environment.id, thread);
+    if (parent) parentIds.set(id, parent);
+  }
+  function ancestorsOf(id) {
+    const ancestors = [];
+    const seen = new Set([id]);
+    let parent = parentIds.get(id);
+    while (parent && byId.has(parent)) {
+      if (seen.has(parent)) return []; // An inconsistent/cyclic relation stays visible.
+      seen.add(parent);
+      ancestors.push(parent);
+      parent = parentIds.get(parent);
+    }
+    return ancestors;
+  }
+  return { byId, parentIds, ancestorsOf };
+}
+
+module.exports = { parentKeyOf, createT3ThreadGraph };
