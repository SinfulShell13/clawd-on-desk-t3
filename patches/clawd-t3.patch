@@ -0,0 +1,13 @@
+"use strict";
+
+// The T3 runtime owns authentication and explicit actions, independently of HTTP hook approvals.
+module.exports = {
+  id: "t3-code", name: "T3 Code", eventSource: "rpc",
+  processNames: { win: [], mac: [], linux: [] },
+  startupRecoveryProcessNames: { win: [], mac: [], linux: [] },
+  eventMap: {},
+  capabilities: {
+    httpHook: false, permissionApproval: false, mobilePermissionObservation: false,
+    interactiveBubble: false, notificationHook: false, sessionEnd: false, subagent: false,
+  },
+};
