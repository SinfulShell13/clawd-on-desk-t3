+"use strict";
+
+const { it } = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const { spawnSync, spawn } = require("node:child_process");
+const { once } = require("node:events");
+const initUpdater = require("../src/updater");
+
+it("a migrated local T3 build cannot fetch, download, install or git-pull an upstream update, even with old pending preferences", async () => {
+  const forbidden = () => { throw new Error("upstream updater must remain uninitialized"); };
+  const prefs = { autoUpdateCheck: true, pendingUpdateVersion: "99.0.0", pendingUpdatePrompted: false };
+  const updater = initUpdater({
+    localT3Build: true, t: key => key,
+    getUpdatePref: key => prefs[key], setUpdatePref: forbidden,
+  }, { httpsGetImpl: forbidden, execFileImpl: forbidden, autoUpdaterFactory: forbidden });
+  updater.setupAutoUpdater();
+  updater.reconcilePendingOnStartup();
+  updater.handlePendingVersion("99.0.0");
+  updater.startUpdateScheduler();
+  updater.onSilentModeExit();
+  assert.deepEqual(await updater.checkForUpdates(true), { state: "idle", channel: "local-t3" });
+  assert.deepEqual(await updater.checkForUpdates({ intent: "download" }), { state: "idle", channel: "local-t3" });
+  await updater.quietDiscover();
+  assert.equal(updater.isSchedulerRunning(), false);
+  assert.equal(updater.getPendingUpdateVersion(), "");
+  assert.equal(updater.getUpdateMenuItem().enabled, false);
+  assert.deepEqual(prefs, { autoUpdateCheck: true, pendingUpdateVersion: "99.0.0", pendingUpdatePrompted: false });
+});
+
+const windows = { skip: process.platform !== "win32" ? "requires Windows PowerShell 5.1" : false };
+function fixture(t) {
+  const temp = fs.realpathSync.native(os.tmpdir());
+  const root = fs.mkdtempSync(path.join(temp, "clawd-t3-migration-"));
+  t.after(() => {
+    // The only recursive removal in this test is its own checked temp tree.
+    assert.equal(path.dirname(root), temp);
+    assert.ok(path.basename(root).startsWith("clawd-t3-migration-"));
+    fs.rmSync(root, { recursive: true, force: true });
+  });
+  const app = path.join(root, "Clawd's 安装目录");
+  const data = path.join(root, "user data");
+  const home = path.join(root, ".clawd");
+  const backups = path.join(root, "backups");
+  for (const dir of [path.join(app, "resources"), path.join(data, "themes", "my-theme"), home, path.join(data, "Cache")]) fs.mkdirSync(dir, { recursive: true });
+  fs.writeFileSync(path.join(app, "Clawd on Desk.exe"), "original-exe-fixture");
+  fs.writeFileSync(path.join(app, "resources", "app.asar"), "original-asar-fixture");
+  fs.writeFileSync(path.join(data, "clawd-prefs.json"), JSON.stringify({ theme: "my-theme", autoUpdateCheck: true, unknownUserPreference: "fixture-secret" }));
+  fs.writeFileSync(path.join(data, "themes", "my-theme", "theme.json"), "theme-fixture");
+  fs.writeFileSync(path.join(data, "Cache", "cache.bin"), "omit-cache");
+  fs.writeFileSync(path.join(home, "runtime.json"), "managed-hook-runtime-fixture");
+  return { root, app, data, home, backups };
+}
+function run(f, extra = []) {
+  return spawnSync("powershell.exe", [
+    "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", path.join(__dirname, "../build/t3-migration-backup.ps1"),
+    "-InstallDir", f.app, "-UserDataDir", f.data, "-ClawdHome", f.home, "-BackupRoot", f.backups, ...extra,
+  ], { encoding: "utf8", windowsHide: true, timeout: 30000 });
+}
+
+it("backs up the original app, preferences, custom theme and managed runtime without modifying live data", windows, t => {
+  const f = fixture(t);
+  const before = fs.readFileSync(path.join(f.data, "clawd-prefs.json"));
+  const complete = path.join(f.root, "complete");
+  const result = run(f, ["-CompletionFile", complete]);
+  assert.equal(result.status, 0, result.stdout + result.stderr);
+  assert.doesNotMatch(result.stdout, /fixture-secret/);
+  const backup = fs.readFileSync(complete, "utf8").replace(/^\uFEFF/, "").trim();
+  assert.equal(path.dirname(backup), f.backups);
+  const manifest = JSON.parse(fs.readFileSync(path.join(backup, "migration.json"), "utf8").replace(/^\uFEFF/, ""));
+  assert.equal(manifest.complete, true);
+  assert.equal(manifest.liveDataModified, false);
+  assert.equal(manifest.verifiedFiles.length, 3);
+  assert.deepEqual(fs.readFileSync(path.join(f.data, "clawd-prefs.json")), before);
+  assert.deepEqual(fs.readFileSync(path.join(backup, "user-data", "clawd-prefs.json")), before);
+  assert.equal(fs.readFileSync(path.join(backup, "original-app", "resources", "app.asar"), "utf8"), "original-asar-fixture");
+  assert.equal(fs.readFileSync(path.join(backup, "user-data", "themes", "my-theme", "theme.json"), "utf8"), "theme-fixture");
+  assert.equal(fs.readFileSync(path.join(backup, "clawd-home", "runtime.json"), "utf8"), "managed-hook-runtime-fixture");
+  assert.equal(fs.existsSync(path.join(backup, "user-data", "Cache")), false);
+  const acl = spawnSync("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command", "[IO.Directory]::GetAccessControl($env:CLAWD_TEST_BACKUP).AreAccessRulesProtected"], {
+    env: { ...process.env, CLAWD_TEST_BACKUP: backup }, encoding: "utf8", windowsHide: true, timeout: 10000,
+  });
+  assert.equal(acl.status, 0, acl.stderr);
+  assert.equal(acl.stdout.trim(), "True");
+});
+
+it("refuses a running install without killing it or touching app/preferences", windows, async t => {
+  const f = fixture(t);
+  const worker = path.join(f.app, "migration-test-worker.exe");
+  fs.copyFileSync(path.join(process.env.SystemRoot, "System32", "cmd.exe"), worker);
+  const child = spawn(worker, ["/d", "/c", "set /p clawdMigrationFixture=ready"], { windowsHide: true, stdio: "pipe" });
+  try {
+    await once(child.stdout, "data");
+    const plan = run(f, ["-PlanOnly"]);
+    assert.equal(plan.status, 0, plan.stderr);
+    const parsed = JSON.parse(plan.stdout.replace(/^\uFEFF/, ""));
+    assert.ok(parsed.runningProcessIds.includes(child.pid));
+    assert.equal(fs.existsSync(f.backups), false);
+    const result = run(f);
+    assert.equal(result.status, 2, result.stdout + result.stderr);
+    assert.match(result.stdout, /Exit Clawd from its tray menu/);
+    assert.equal(child.exitCode, null);
+    assert.equal(fs.existsSync(f.backups), false);
+    assert.equal(fs.readFileSync(path.join(f.app, "resources", "app.asar"), "utf8"), "original-asar-fixture");
+  } finally {
